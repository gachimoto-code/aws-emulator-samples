# Server
PORT=4000

# AWS Emulator (local). Start the emulator first: `aws-emulator`
# It serves HTTPS on 127.0.0.1:9297 and writes a config + credentials
# under ~/.aws/emulator/9297/ on startup. Point the SDK at those files.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_CONFIG_FILE=/home/<you>/.aws/emulator/9297/config
AWS_SHARED_CREDENTIALS_FILE=/home/<you>/.aws/emulator/9297/emulator_credentials
# CA certificate the emulator generated, so the SDK trusts its HTTPS endpoint.
AWS_EMULATOR_CA_PATH=/home/<you>/.aws/emulator/9297/ca.pem

# Resources (created automatically on startup if missing)
DYNAMODB_TABLE=Notes
S3_BUCKET=notes-attachments

# For real AWS instead of the emulator: remove AWS_ENDPOINT_URL and the
# emulator file settings above, and provide real credentials via the
# standard AWS SDK credential chain.
